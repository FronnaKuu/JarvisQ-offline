{
  "appId": "com.jarvisqvac.desktop",
  "productName": "JarvisQVAC",
  "copyright": "© JarvisQVAC",
  "directories": {
    "output": "release/desktop/win",
    "buildResources": "electron/build"
  },
  "extraMetadata": {
    "main": "build/desktop/main.mjs"
  },
  "files": [
    "build/desktop/**/*",
    "qvac/**/*",
    "package.json",
    "!node_modules/@qvac/diffusion-cpp/**/*",
    "!node_modules/@qvac/embed-llamacpp/**/*",
    "!node_modules/@qvac/ocr-onnx/**/*",
    "!node_modules/@qvac/*/prebuilds/android-*/**/*",
    "!node_modules/@qvac/*/prebuilds/ios-*/**/*",
    "!node_modules/@qvac/*/prebuilds/darwin-*/**/*",
    "!node_modules/@qvac/*/prebuilds/linux-*/**/*",
    "!node_modules/@qvac/*/prebuilds/win32-arm64/**/*",
    "!node_modules/bare-*/prebuilds/android-*/**/*",
    "!node_modules/bare-*/prebuilds/ios-*/**/*",
    "!node_modules/bare-*/prebuilds/darwin-*/**/*",
    "!node_modules/bare-*/prebuilds/linux-*/**/*",
    "!node_modules/bare-*/prebuilds/win32-arm64/**/*",
    "!node_modules/react-native-bare-kit/**/*",
    "!node_modules/react-native/**/*",
    "!node_modules/react-native-*/**/*",
    "!node_modules/@react-native/**/*",
    "!node_modules/@react-native-*/**/*",
    "!node_modules/expo/**/*",
    "!node_modules/expo-*/**/*",
    "!node_modules/@expo/**/*",
    "!node_modules/babel-*/**/*",
    "!node_modules/@babel/**/*",
    "!node_modules/metro/**/*",
    "!node_modules/metro-*/**/*",
    "!node_modules/@metro*/**/*",
    "!node_modules/react-devtools-core/**/*",
    "!node_modules/lightningcss/**/*",
    "!node_modules/@types/**/*",
    "!**/*.{md,markdown,flow}",
    "!**/{test,tests,__tests__,docs,doc,examples,example}/**/*"
  ],
  "asar": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "JarvisQVAC-${version}-${arch}.${ext}",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "JarvisQVAC"
  },
  "publish": null
}
