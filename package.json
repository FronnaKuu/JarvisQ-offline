{
  "name": "jarvisq",
  "version": "1.1.1",
  "description": "Private, on-device voice assistant — STT, LLM, and TTS running fully locally. Powered by the Tether QVAC SDK. Mobile (Android via Expo + React Native) and desktop (Windows / macOS / Linux via Electron) from a shared hexagonal core.",
  "main": "index.ts",
  "license": "Apache-2.0",
  "author": "Helldez <74499579+Helldez@users.noreply.github.com>",
  "homepage": "https://github.com/Helldez/JarvisQ#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Helldez/JarvisQ.git"
  },
  "bugs": {
    "url": "https://github.com/Helldez/JarvisQ/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:bundle-worker": "npx @qvac/cli bundle sdk",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron build/desktop/main.mjs",
    "desktop:dist:win": "npm run desktop:build && electron-builder --win --x64 -c electron-builder.json",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qvac/llm-llamacpp": "^0.14.4",
    "@qvac/sdk": "^0.9.0",
    "@qvac/transcription-whispercpp": "^0.6.1",
    "@qvac/translation-nmtcpp": "^0.6.10",
    "@qvac/tts-onnx": "^0.8.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "bare-abort-controller": "^1.1.1",
    "bare-buffer": "^3.6.0",
    "bare-crypto": "^1.13.4",
    "bare-dns": "^2.1.4",
    "bare-fetch": "^2.8.2",
    "bare-fs": "^4.7.0",
    "bare-http1": "^4.5.6",
    "bare-https": "^2.1.3",
    "bare-link": "^3.1.0",
    "bare-net": "^2.3.1",
    "bare-os": "^3.8.7",
    "bare-path": "^3.0.0",
    "bare-process": "^4.4.1",
    "bare-readline": "^1.3.1",
    "bare-rpc": "^1.2.0",
    "bare-runtime": "^1.28.4",
    "bare-stream": "^2.13.0",
    "bare-subprocess": "^6.0.0",
    "bare-url": "^2.4.0",
    "bare-zlib": "^1.3.3",
    "buffer": "^6.0.3",
    "compact-encoding": "^2.19.2",
    "corestore": "^7.9.2",
    "events": "^3.3.0",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-battery": "~10.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~17.0.0",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-linking": "~7.0.0",
    "expo-router": "~6.0.23",
    "expo-speech": "^55.0.13",
    "expo-splash-screen": "^55.0.18",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "hyperdb": "^4.22.3",
    "hyperdrive": "^13.3.2",
    "hyperswarm": "^4.17.0",
    "llm-splitter": "^0.2.0",
    "pear-pipe": "^1.0.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "~0.11.5",
    "react-native-live-audio-stream": "^1.1.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "^4.24.0",
    "react-native-vector-icons": "^10.3.0",
